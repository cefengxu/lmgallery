# 服务端口（<1024 在多数系统上需 root/特权；开发环境可设 3738）
PORT=3738

# 对外访问基准 URL（云端填公网 IP 或域名 + 端口，无尾斜杠）
# APP_BASE_URL=http://18.222.221.196:3738
APP_BASE_URL=

# ── Unsplash（https://unsplash.com/oauth/applications）
# Application ID、Secret 用于 OAuth 等场景；当前搜索接口仅读取 UNSPLASH_ACCESS_KEY
UNSPLASH_APPLICATION_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# https://www.pexels.com/api/
# 至少配置 _1；可同时配置 _2、_3 … 按数字序号排序后轮流使用，单次请求会从 process.env 重新读取。
PEXELS_API_KEY_1=
# PEXELS_API_KEY_2=
# PEXELS_API_KEY_3=

# 每次搜索目标总条数。合并接口 /api/search/combined 会按随机 5:5 或 4:6 拆成两笔请求（Pexels 1–80、Unsplash 单页 ≤30）
PEXELS_PER_PAGE=3

# 主图（下载用 URL）最长边不超过约多少像素；Pexels 仅有离散档位（约 1280 / 650 / 350 …）。
# 不设则优先 large2x → large → original，不按像素封顶。
# PEXELS_IMAGE_MAX_EDGE=1280

# Vite 开发服务器放行域名策略。设为 true 允许所有 Host（适用于 nginx 反代场景）；
# 不设则仅放行 IP / localhost（默认行为，适用于无反代的直连场景）。
# ALLOWED_HOSTS=true
