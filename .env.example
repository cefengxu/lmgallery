# 服务端口（<1024 在多数系统上需 root/特权；开发环境可设 3738）
PORT=3738

# 对外访问基准 URL（云端填公网 IP 或域名 + 端口，无尾斜杠）
# APP_BASE_URL=http://18.222.221.196:3738
APP_BASE_URL=

# https://www.pexels.com/api/
# 至少配置 _1；可同时配置 _2、_3 … 按数字序号排序后轮流使用，单次请求会从 process.env 重新读取。
PEXELS_API_KEY_1=
# PEXELS_API_KEY_2=
# PEXELS_API_KEY_3=

# 每次搜索最多返回的照片数量（1–80，与 Pexels API 的 per_page 一致）
PEXELS_PER_PAGE=3

# 主图（下载用 URL）最长边不超过约多少像素；Pexels 仅有离散档位（约 1280 / 650 / 350 …）。
# 不设则优先 large2x → large → original，不按像素封顶。
# PEXELS_IMAGE_MAX_EDGE=1280
